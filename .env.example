PORT=3000
MONGODB_URI=mongodb://localhost:27017/clinic_management
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h
NODE_ENV=development
DEFAULT_APPOINTMENT_DURATION=30

# IANA timezone the clinic operates in. Scheduling compares wall-clock times,
# so this must match the clinic's local time rather than the host's timezone
# (most hosts default to UTC).
CLINIC_TIMEZONE=Asia/Kolkata
